<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦  JOIN OUR COMMUNITY"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Your Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete your details and become a loyalty member."
            android:textColor="#718096"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"/>

        <!-- PERSONAL DETAILS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL INFORMATION"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:backgroundTint="#CBD5E1"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Phone Number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#CBD5E1"/>

        <EditText
            android:id="@+id/etDob"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Date of Birth"
            android:focusable="false"
            android:clickable="true"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#CBD5E1"/>

        <EditText
            android:id="@+id/etCustomerEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#CBD5E1"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:hint="Full Address"
            android:inputType="textPostalAddress|textMultiLine"
            android:gravity="top"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#CBD5E1"/>

        <!-- ACCOUNT SECURITY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT SECURITY"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Create Password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:backgroundTint="#CBD5E1"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#CBD5E1"/>

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="SUBMIT REGISTRATION"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By registering, you agree to join our customer loyalty program."
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
